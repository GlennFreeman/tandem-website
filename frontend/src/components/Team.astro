---
import { Image } from "astro:assets";
import caleb from "../assets/caleb nwasike.jpg";
import glenn from "../assets/glenn_freeman.png";
import bradley from "../assets/bradley_crasto.jpg";
import jake from "../assets/jake_cashion.jpg";

// From each member's Devpost profile. TODO: add role, graduation date, internship interest, dream job.
const team = [
  {
    name: "Caleb Nwasike",
    photo: caleb,
    where: "Kennesaw, GA",
    skills: ["Java", "Python", "R", "SQL", "Shell"],
    links: [["LinkedIn", "https://www.linkedin.com/in/caleb-nwasike/"]],
  },
  {
    name: "Glenn Freeman",
    photo: glenn,
    where: "Lithia Springs, GA",
    skills: ["Python", "HTML5", "CSS3", "Tailwind", "Astro"],
    links: [
      ["GitHub", "https://github.com/GlennFreeman"],
      ["LinkedIn", "https://www.linkedin.com/in/glennjlfreeman/"],
    ],
  },
  {
    name: "Bradley Crasto",
    photo: bradley,
    where: "Atlanta, GA",
    skills: ["Web"],
    links: [
      ["GitHub", "https://github.com/skearya"],
      ["Website", "https://skeary.me/"],
    ],
  },
  {
    name: "Jake Cashion",
    photo: jake,
    where: "Atlanta, GA",
    skills: ["Java", "JavaScript", "React", "Vue", "Node.js"],
    other: "GroundCheck",
    links: [["GitHub", "https://github.com/jakecashion"]],
  },
];
---

<section id="team" aria-labelledby="team-title">
  <h2 id="team-title" class="mb-8 text-3xl font-bold">The team</h2>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      team.map((m) => (
        <li class="card bg-base-200">
          <div class="card-body">
            <Image
              src={m.photo}
              alt=""
              width={192}
              height={192}
              class="size-24 rounded-full object-cover"
            />
            <h3 class="card-title">{m.name}</h3>
            <p class="text-sm opacity-70">{m.where}</p>
            <div class="flex flex-wrap gap-1">
              {m.skills.map((k) => (
                <span class="badge badge-outline badge-sm">{k}</span>
              ))}
            </div>
            {m.other && <p class="text-sm">Also built: {m.other}</p>}
            <div class="card-actions mt-2 flex-wrap">
              {m.links.map(([label, href]) => (
                <a
                  class="link link-primary inline-flex items-center gap-1 text-sm"
                  href={href}
                  target="_blank"
                  rel="noopener"
                >
                  {label}
                  <span class="sr-only"> (opens in new tab)</span>
                  <svg
                    aria-hidden="true"
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
