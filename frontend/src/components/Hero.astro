---
import { Image } from 'astro:assets';
import tandem from '../assets/tandem.png';
---

<header id="top" class="hero min-h-[70vh] py-12 bg-gradient-to-b from-base-200 to-base-100">
  <div class="hero-content text-center">
    <div class="max-w-3xl">
      <div class="badge badge-primary mb-4">Hacklanta · Creative track · C-Day @ KSU</div>
      <h1 class="text-5xl font-bold sm:text-6xl">Premiere Pro, <span class="text-primary">multiplayer</span>.</h1>
      <p class="py-6 text-lg">Edit the same timeline, at the same time, from different computers. Like Google Docs for your timeline.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="#try" class="btn btn-primary">Try it</a>
        <a href="#features" class="btn btn-outline">What it does</a>
      </div>
      <Image src={tandem} alt="Two Premiere Pro windows, each showing the other editor's live cursor" class="rounded-box mx-auto mt-10 w-full max-w-xl shadow-lg" />
    </div>
  </div>
</header>
