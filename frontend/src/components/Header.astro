---
import { Image } from 'astro:assets';
import logo from '../assets/tandem logo crop.png';

const links = [
  ['Demo', '#demo'],
  ['Features', '#features'],
  ['Problem', '#problem'],
  ['How it works', '#how'],
  ['Try it', '#try'],
  ['Team', '#team'],
];
---

<header class="sticky top-0 z-10">
  <nav aria-label="Primary" class="navbar bg-base-200 px-4">
    <a href="#" class="btn btn-ghost gap-2 text-xl"><Image src={logo} alt="" class="h-6 w-auto" />Tandem</a>
    <ul class="ml-auto hidden gap-1 sm:flex">
      {links.map(([label, href]) => <li><a class="btn btn-ghost btn-sm" href={href}>{label}</a></li>)}
    </ul>
    <details class="dropdown dropdown-end ml-auto sm:hidden">
      <summary class="btn btn-ghost" aria-label="Menu">
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </summary>
      <ul class="menu dropdown-content rounded-box bg-base-200 z-1 mt-2 w-48 p-2 shadow">
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </details>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.querySelectorAll('details.dropdown a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
